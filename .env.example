# Copy this file to .env and fill in values. Never commit .env.

# ── Project paths ──────────────────────────────────────────────────────────────
PROJECT_ROOT=.
DATA_DIR=./data
OUTPUT_DIR=./outputs

# ── Random seed ────────────────────────────────────────────────────────────────
RANDOM_SEED=42

# ── Optional: Hugging Face (free tier, no billing required) ───────────────────
# HF_TOKEN=hf_your_token_here

# ── Optional: Reddit public API (free, no scraping) ───────────────────────────
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USER_AGENT=tala-research-bot/0.1

# ── Apify (free tier available — https://apify.com) ───────────────────────────
# Used for: Trustpilot review scraping, Google search scraping
# Set to just the token string: apify_api_xxxxx
APIFY_TOKEN=

# ── YouTube Data API v3 (free quota: 10,000 units/day) ────────────────────────
# Get a key at: https://console.cloud.google.com
YOUTUBE_API_KEY=

# ── Optional scraping service fallbacks (not required) ────────────────────────
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=
SCRAPERAPI_KEY=

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
