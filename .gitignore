# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# Virtual environments
venv/
env/
.venv/
.env/

# Environment variables
.env
*.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw and processed data are NOT committed by default
data/raw/
data/interim/
data/processed/
data/corpora/
data/cache/
# Templates and manual labels ARE tracked (scaffolding + human effort)
!data/raw/templates/
!data/manual_labels/

# Outputs — figures and tables generated; track only intentionally
outputs/figures/
outputs/tables/
# Deck assets may be large; track selectively
outputs/deck_assets/

# OS
.DS_Store
Thumbs.db
desktop.ini

